<div class="kdm-body"><div class="kdm-item-top"><div class="kdm-item-image {{#if isGear}}square{{/if}}"><button type="button" data-action="pickImage" aria-label="Choose Item image" {{#unless editable}}disabled{{/unless}}><img src="{{item.img}}" alt="{{item.name}}"></button><button type="button" class="kdm-preview-link" data-action="previewImage">preview</button></div><div class="kdm-item-fields">
<fieldset {{#unless editable}}disabled{{/unless}}>
<header class="kdm-item-header"><label>Name<input name="name" value="{{item.name}}" required {{#if isProficiency}}readonly{{/if}}></label>
<div><label>Keyword(s)<input data-keyword-entry placeholder="Type a keyword, then Enter"></label><div class="kdm-tags">{{#each tags}}<span>{{this}} <button type="button" data-action="removeKeyword" data-index="{{@index}}" aria-label="Remove {{this}}">×</button></span>{{/each}}</div></div></header>{{#if isProficiency}}<div class="kdm-type-rank"><label>Type<input name="system.type" value="{{system.type}}"></label><div class="kdm-radio-group" role="radiogroup" aria-label="Rank">{{#each ranks}}<label class="kdm-radio-option"><input type="radio" name="system.rank" value="{{value}}" {{checked selected}}>{{label}}</label>{{/each}}</div></div><label>Description<textarea name="system.description" rows="6">{{system.description}}</textarea></label>{{/if}}{{#if isResource}}<label>Quantity<input type="number" name="system.quantity" value="{{system.quantity}}" step="1" min="0"></label>{{/if}}{{#if isGear}}<h2>Attack Profile</h2><div class="kdm-attack-fields"><label>Speed<input type="number" name="system.attack.speed" value="{{system.attack.speed}}" step="1" min="0"></label><label>Accuracy<span class="kdm-accuracy"><input type="number" name="system.attack.accuracy" value="{{system.attack.accuracy}}" step="1" min="0"><span aria-hidden="true" class="kdm-plus">+</span></span></label><label>Strength<input type="number" name="system.attack.strength" value="{{system.attack.strength}}" step="1"></label></div><h2>Edge affinities</h2><div class="kdm-edge-cross">{{#each sides}}<label class="edge-{{side}}">{{side}}<select name="system.affinities.{{side}}">{{#each colors}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{value}}</option>{{/each}}</select></label>{{/each}}</div>{{/if}}{{#if isProficiency}}{{#if system.notes}}<details><summary>Legacy notes</summary><p>{{system.notes}}</p></details>{{/if}}{{else}}<label class="kdm-notes">Description<textarea name="system.notes" rows="4">{{system.notes}}</textarea></label>{{/if}}<label>Source (private reference)<input name="system.source" value="{{system.source}}"></label>
</fieldset></div></div>{{#if editable}}
<footer><button type="submit"><i class="fas fa-save"></i> Save changes</button>
</footer>{{else}}<p>Read-only. Ask the GM for ownership to edit.</p>{{/if}}</div>
