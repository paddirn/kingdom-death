<div class="kdm-body">
<header class="kdm-survivor-header"><label>Survivor name<input name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}} required><small><em>When you name your survivor, gain <strong>+1 survival</strong>.</em></small></label><label>Sex<select name="system.sex" {{#unless editable}}disabled{{/unless}}>{{#each sexChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
</header>

<nav class="tabs kdm-tabs" data-group="primary" aria-label="Survivor tabs"><button type="button" data-action="tab" data-group="primary" data-tab="attributes" class="{{#if active.attributes}}active{{/if}}">Attributes</button><button type="button" data-action="tab" data-group="primary" data-tab="gear" class="{{#if active.gear}}active{{/if}}">Gear</button><button type="button" data-action="tab" data-group="primary" data-tab="specials" class="{{#if active.specials}}active{{/if}}">Specials</button><button type="button" data-action="tab" data-group="primary" data-tab="family" class="{{#if active.family}}active{{/if}}">Family</button><button type="button" data-action="tab" data-group="primary" data-tab="image" class="{{#if active.image}}active{{/if}}">Image</button>
</nav>


<fieldset {{#unless editable}}disabled{{/unless}}>
<div class="tab {{#if active.attributes}}active{{/if}}" data-group="primary" data-tab="attributes"><div class="kdm-paper-columns"><div class="kdm-attribute-column">


<section class="kdm-survival"><h2>Survival</h2><div class="kdm-survival-layout"><div><div class="kdm-stats kdm-square-numbers"><label><span>Current Survival</span><input type="number" min="0" step="1" name="system.survival.value" value="{{system.survival.value}}"></label><label><span>Survival Limit</span><input type="number" min="0" step="1" name="system.survival.limit" value="{{system.survival.limit}}"></label></div><label class="kdm-inline"><input type="checkbox" name="system.cannotSpendSurvival" {{checked system.cannotSpendSurvival}}>🔒 Cannot spend Survival</label></div><div class="kdm-action-checks">{{#each survivalActions}}<label class="kdm-inline"><input type="checkbox" name="system.survivalActions.{{key}}" {{checked checked}}>{{label}}</label>{{/each}}</div></div>
</section>
<div class="kdm-column-rest"><div class="kdm-stat-boxes">{{#each attributes}}<label><input type="number" step="1" name="system.attributes.{{key}}" value="{{value}}"><span>{{label}}</span></label>{{/each}}</div>

<section class="kdm-square-numbers kdm-brain"><h2>Brain</h2><small><em>If your insanity is 3+, you are <strong>insane</strong>.</em></small><label class="kdm-insanity">Insanity<input type="number" min="0" step="1" name="system.insanity" value="{{system.insanity}}"></label><label class="kdm-inline"><input type="checkbox" name="system.brainInjury" {{checked system.brainInjury}}>Brain Injury</label>
</section>
<section><h2>Injuries</h2><p class="kdm-injury-note"><span aria-hidden="true" class="kdm-filled-box"></span> Heavy Injury: Knocked Down (all locations)</p>{{#each locations}}<div class="kdm-location kdm-square-numbers"><label class="kdm-armor"><input aria-label="{{label}} armor" type="number" min="0" step="1" name="system.locations.{{key}}.armor" value="{{armor}}"></label><h3><svg class="kdm-anatomy" aria-hidden="true" viewBox="0 0 24 24"><use href="systems/kingdom-death/styles/anatomy.svg#{{key}}"></use></svg>{{label}}</h3>{{#if hasLight}}<label>Light<input type="checkbox" name="system.locations.{{key}}.light" {{checked light}}></label>{{/if}}<label>Heavy<input type="checkbox" name="system.locations.{{key}}.heavy" {{checked heavy}}></label></div>{{/each}}
</section></div></div><div class="kdm-attribute-column">

<section class="kdm-hunt-xp"><h2>Hunt XP</h2><div class="kdm-track">{{#with huntTrack}}<div class="kdm-track-boxes">{{#each boxes}}<input type="checkbox" aria-label="Hunt XP {{value}}" class="{{#if milestone}}milestone{{/if}}" data-action="progress" data-path="system.{{../path}}" data-value="{{value}}" {{checked checked}}>{{/each}}</div><label>XP:<input type="number" readonly min="0" step="1" name="system.{{path}}" value="{{value}}"></label>{{/with}}</div><small>Milestones: 2 / 6 / 10 / 15 · Retirement: 16</small>
</section>
<div class="kdm-column-rest">
<section data-kdm-drop="proficiency"><h2>Weapon Proficiency</h2><div class="kdm-track">{{#with proficiencyTrack}}<div class="kdm-track-boxes">{{#each boxes}}<input type="checkbox" aria-label="Weapon Proficiency {{value}}" class="{{#if milestone}}milestone{{/if}}" data-action="progress" data-path="system.{{../path}}" data-value="{{value}}" {{checked checked}}>{{/each}}</div><label>Total<input type="number" readonly min="0" step="1" name="system.{{path}}" value="{{value}}"></label>{{/with}}</div><div class="kdm-proficiency-link">{{#if proficiencyAvailable}}<a href="#" class="content-link" data-type="Item" data-uuid="{{proficiencyUuid}}" data-link draggable="true">{{proficiencyName}}</a>{{else}}{{#if proficiencyUuid}}<span class="kdm-missing-link">Missing or unavailable Proficiency — drop a replacement</span>{{else}}<span class="kdm-empty">Drop Proficiency Item here</span>{{/if}}{{/if}}</div><label class="kdm-inline"><input type="checkbox" name="system.weaponProficiency.specialist" {{checked system.weaponProficiency.specialist}}>Specialist</label><label class="kdm-inline"><input type="checkbox" name="system.weaponProficiency.master" {{checked system.weaponProficiency.master}}>Master</label>
</section>
<section><h2>Courage</h2><div class="kdm-track">{{#with courageTrack}}<div class="kdm-track-boxes">{{#each boxes}}<input type="checkbox" aria-label="Courage {{value}}" class="{{#if milestone}}milestone{{/if}}" data-action="progress" data-path="system.{{../path}}" data-value="{{value}}" {{checked checked}}>{{/each}}</div><label>Total<input type="number" readonly min="0" step="1" name="system.{{path}}" value="{{value}}"></label>{{/with}}</div><small>Milestones: 3 · Bold / 9 · See the Truth</small>{{#with courageOptions}}<div class="kdm-radio-group" role="radiogroup" aria-label="{{path}}">{{#each options}}<label class="kdm-radio-option"><input type="radio" name="system.{{../path}}" value="{{value}}" {{checked selected}}><span><strong>{{title}}</strong>{{#if description}}: <small>{{description}}</small>{{/if}}</span></label>{{/each}}</div>{{/with}}
</section>
<section><h2>Understanding</h2><div class="kdm-track">{{#with understandingTrack}}<div class="kdm-track-boxes">{{#each boxes}}<input type="checkbox" aria-label="Understanding {{value}}" class="{{#if milestone}}milestone{{/if}}" data-action="progress" data-path="system.{{../path}}" data-value="{{value}}" {{checked checked}}>{{/each}}</div><label>Total<input type="number" readonly min="0" step="1" name="system.{{path}}" value="{{value}}"></label>{{/with}}</div><small>Milestones: 3 · Insight / 9 · White Secret</small>{{#with understandingOptions}}<div class="kdm-radio-group" role="radiogroup" aria-label="{{path}}">{{#each options}}<label class="kdm-radio-option"><input type="radio" name="system.{{../path}}" value="{{value}}" {{checked selected}}><span><strong>{{title}}</strong>{{#if description}}: <small>{{description}}</small>{{/if}}</span></label>{{/each}}</div>{{/with}}
</section></div></div></div>
<section class="kdm-conditions"><h2>Condition &amp; Notes</h2><div class="kdm-checks"><label class="kdm-inline"><input type="checkbox" name="system.knockedDown" {{checked system.knockedDown}}>Knocked Down</label><label class="kdm-inline"><input type="checkbox" name="system.retired" {{checked system.retired}}>Retired</label><label class="kdm-inline"><input type="checkbox" name="system.dead" {{checked system.dead}}>Dead</label></div><div class="kdm-token-counters kdm-square-numbers"><label><span>Bleeding tokens</span><input type="number" min="0" step="1" name="system.bleeding" value="{{system.bleeding}}"></label>{{#each customTokens}}<label><input aria-label="Custom token label {{key}}" name="system.customTokens.{{key}}.label" value="{{label}}"><input type="number" min="0" step="1" aria-label="{{label}}" name="system.customTokens.{{key}}.value" value="{{value}}"></label>{{/each}}</div><label>Notes<textarea name="system.notes" rows="6">{{system.notes}}</textarea></label><small>Milestones, injuries and action restrictions are manual records.</small>
</section></div>
<div class="tab {{#if active.gear}}active{{/if}}" data-group="primary" data-tab="gear">
<section><h2>Gear grid</h2><p class="kdm-hint">Drop Gear into a cell to equip it. Drag cards to move them; × unequips without deleting. Gear changes save immediately.</p><div class="kdm-gear-grid">{{#each cells}}<div class="kdm-gear-cell" data-kdm-drop="gear" data-slot="{{key}}" aria-label="Gear position {{index}}">{{#if item}}<a class="kdm-gear-card draggable" data-item-id="{{item.id}}" data-action="editItem" role="button" tabindex="0" draggable="true"><img src="{{item.img}}" alt="" draggable="false"><span>{{item.name}}</span></a>{{else}}{{#if missing}}<span class="kdm-empty">Missing gear</span>{{else}}<span class="kdm-empty" aria-label="Drop Gear here">＋</span>{{/if}}{{/if}}{{#if itemId}}{{#if @root.editable}}<button type="button" class="kdm-clear-gear" data-action="clearGear" data-slot="{{key}}" aria-label="Unequip Gear">×</button>{{/if}}{{/if}}</div>{{/each}}</div>
</section>

<section data-kdm-drop="inventory"><h2>Inventory</h2><p class="kdm-hint">Drop Items here to add them. Click a name to open its owned sheet. Drag owned Gear into the grid.</p><div class="kdm-actions"><button type="button" data-action="addItem" data-type="gear">Add gear</button><button type="button" data-action="addItem" data-type="resource">Add resource</button></div><ul class="kdm-inventory kdm-inventory-cards">{{#each inventory}}<li class="draggable" data-item-id="{{id}}" draggable="true"><a data-action="editItem" data-item-id="{{id}}" role="button" tabindex="0"><img src="{{img}}" alt="" draggable="false"><span>{{name}}<small>{{type}}</small></span></a>{{#if @root.editable}}<button type="button" data-action="deleteItem" data-item-id="{{id}}" aria-label="Delete {{name}}">×</button>{{/if}}</li>{{else}}<li>No items yet.</li>{{/each}}</ul>
</section></div><div class="tab {{#if active.specials}}active{{/if}}" data-group="primary" data-tab="specials">
<section data-kdm-drop="fightingArt"><h2>Fighting Arts</h2><p>Maximum 3</p><label class="kdm-inline"><input type="checkbox" name="system.cannotUseFightingArts" {{checked system.cannotUseFightingArts}}>🔒 Cannot use Fighting Arts</label><button type="button" data-action="addItem" data-type="fightingArt">Add Fighting Arts</button><ul class="kdm-inventory">{{#each arts}}<li data-item-id="{{id}}"><span>{{name}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></li>{{else}}<li>None recorded.</li>{{/each}}</ul>
</section>
<section data-kdm-drop="disorder"><h2>Disorders</h2><p>Maximum 3</p><button type="button" data-action="addItem" data-type="disorder">Add Disorders</button><ul class="kdm-inventory">{{#each disorders}}<li data-item-id="{{id}}"><span>{{name}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></li>{{else}}<li>None recorded.</li>{{/each}}</ul>
</section>
<section data-kdm-drop="ability"><h2>Abilities &amp; Impairments</h2><label class="kdm-inline"><input type="checkbox" name="system.skipNextHunt" {{checked system.skipNextHunt}}>🔒 Skip Next Hunt</label><label>Impairments<textarea name="system.impairments" rows="4">{{system.impairments}}</textarea></label><button type="button" data-action="addItem" data-type="ability">Add Abilities &amp; Impairments</button><ul class="kdm-inventory">{{#each abilities}}<li data-item-id="{{id}}"><span>{{name}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></li>{{else}}<li>None recorded.</li>{{/each}}</ul>
</section>
<section><h2>Once Per Lifetime</h2><label>Notes<textarea name="system.oncePerLifetime" rows="4">{{system.oncePerLifetime}}</textarea></label><label class="kdm-inline"><input type="checkbox" name="system.rerollUsed" {{checked system.rerollUsed}}>Reroll Used</label>
</section></div>
</fieldset><div class="tab {{#if active.family}}active{{/if}}" data-group="primary" data-tab="family">
<section class="kdm-family"><h2>Family</h2><p>Assignments save immediately on both world Survivors. A GM can assign links when you do not own every affected Survivor.</p><h3>Parents</h3><div class="kdm-parents">{{#each family.parents}}<div class="kdm-family-node" data-family-slot data-kind="{{kind}}" data-slot="{{slot}}">{{#if available}}<button type="button" class="kdm-family-open" data-action="openFamily" data-actor-id="{{id}}"><span class="kdm-portrait"><img src="{{img}}" alt="">{{#if dead}}<span class="kdm-dead" aria-label="Dead">×</span>{{/if}}</span><span>{{name}}</span></button>{{else}}<div class="kdm-missing">{{name}}</div>{{/if}}<label>{{#if add}}Add Child{{else}}Replace / select Survivor{{/if}}<select {{#unless @root.editable}}disabled{{/unless}}><option value="">Empty</option>{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><div class="kdm-actions"><button type="button" data-action="familyApply" {{#unless @root.editable}}disabled{{/unless}}>{{#if add}}Add Child{{else}}Assign{{/if}}</button>{{#if id}}<button type="button" data-action="familyClear" {{#unless @root.editable}}disabled{{/unless}}>Clear</button>{{/if}}</div></div>{{/each}}</div><div class="kdm-current">{{#with family.current}}{{#if available}}<button type="button" class="kdm-family-open" data-action="openFamily" data-actor-id="{{id}}"><span class="kdm-portrait"><img src="{{img}}" alt="">{{#if dead}}<span class="kdm-dead" aria-label="Dead">×</span>{{/if}}</span><span>{{name}}</span></button>{{else}}<div class="kdm-missing">{{name}}</div>{{/if}}{{/with}}</div><h3>Children</h3><div class="kdm-children">{{#each family.children}}<div class="kdm-family-node" data-family-slot data-kind="{{kind}}" data-slot="{{slot}}">{{#if available}}<button type="button" class="kdm-family-open" data-action="openFamily" data-actor-id="{{id}}"><span class="kdm-portrait"><img src="{{img}}" alt="">{{#if dead}}<span class="kdm-dead" aria-label="Dead">×</span>{{/if}}</span><span>{{name}}</span></button>{{else}}<div class="kdm-missing">{{name}}</div>{{/if}}<label>{{#if add}}Add Child{{else}}Replace / select Survivor{{/if}}<select {{#unless @root.editable}}disabled{{/unless}}><option value="">Empty</option>{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label><div class="kdm-actions"><button type="button" data-action="familyApply" {{#unless @root.editable}}disabled{{/unless}}>{{#if add}}Add Child{{else}}Assign{{/if}}</button>{{#if id}}<button type="button" data-action="familyClear" {{#unless @root.editable}}disabled{{/unless}}>Clear</button>{{/if}}</div></div>{{/each}}</div>
</section></div><div class="tab {{#if active.image}}active{{/if}}" data-group="primary" data-tab="image">
<section><h2>Images</h2><p>Image choices save immediately. Prototype token changes affect future placements only.</p><div class="kdm-image-controls"><div><h3>Actor Avatar</h3><button type="button" data-action="actorImage" data-image-path="img" aria-label="Choose Actor avatar" {{#unless editable}}disabled{{/unless}}><img src="{{actor.img}}" alt="Actor Avatar"></button></div><div><h3>Actor Token</h3><button type="button" data-action="actorImage" data-image-path="prototypeToken.texture.src" aria-label="Choose prototype token image" {{#unless editable}}disabled{{/unless}}><img src="{{actor.prototypeToken.texture.src}}" alt="Actor Token"></button></div></div>
</section></div>{{#if editable}}
<footer><button type="submit">Save changes</button>
</footer>{{else}}<p>Read-only. Ask the GM for ownership to edit.</p>{{/if}}</div>
