<div class="kdm-body"><fieldset {{#unless editable}}disabled{{/unless}}><header class="kdm-header"><p class="kdm-eyebrow">Kingdom Death: Monster · Foundation</p><label>Name <input name="name" value="{{actor.name}}" required></label></header>
<section><h2>Survivor</h2><div class="kdm-stats">{{#each attributes}}<label>{{label}}<input type="number" step="1" name="system.attributes.{{key}}" value="{{value}}"></label>{{/each}}</div>
<div class="kdm-stats"><label>Survival<input type="number" name="system.survival.value" value="{{system.survival.value}}" step="1" min="0"></label><label>Survival limit (manual)<input type="number" name="system.survival.limit" value="{{system.survival.limit}}" step="1" min="0"></label><label>Insanity<input type="number" name="system.insanity" value="{{system.insanity}}" step="1" min="0"></label><label>Bleeding tokens<input type="number" name="system.bleeding" value="{{system.bleeding}}" step="1" min="0"></label><label>Hunt XP<input type="number" name="system.huntXP" value="{{system.huntXP}}" step="1" min="0"></label><label>Understanding<input type="number" name="system.understanding" value="{{system.understanding}}" step="1" min="0"></label><label>Courage<input type="number" name="system.courage" value="{{system.courage}}" step="1" min="0"></label>
</div><div class="kdm-checks"><label><input type="checkbox" name="system.brainInjury" {{checked system.brainInjury}}> Brain injury</label><label><input type="checkbox" name="system.knockedDown" {{checked system.knockedDown}}> Knocked down</label><label><input type="checkbox" name="system.retired" {{checked system.retired}}> Retired</label><label><input type="checkbox" name="system.dead" {{checked system.dead}}> Dead</label></div></section>
<section><h2>Armor &amp; injury boxes</h2><p class="kdm-hint">Manual tracking. No automatic damage, knockdown, severe injury, or survival-limit enforcement.</p><table><thead><tr><th>Location</th><th>Armor</th><th>Light</th><th>Heavy</th></tr></thead><tbody>{{#each locations}}<tr><th>{{label}}</th><td><input aria-label="{{label}} armor" type="number" min="0" step="1" name="system.locations.{{key}}.armor" value="{{armor}}"></td><td>{{#if hasLight}}<input aria-label="{{label}} light injury" type="checkbox" name="system.locations.{{key}}.light" {{checked light}}>{{else}}—{{/if}}</td><td><input aria-label="{{label}} heavy injury" type="checkbox" name="system.locations.{{key}}.heavy" {{checked heavy}}></td></tr>{{/each}}</tbody></table></section>
<section><h2>Gear grid</h2><p class="kdm-hint">Add or drop gear into inventory, then assign it below and Save. Each owned copy can occupy one cell. Affinities are stored on gear; bonuses are not calculated.</p><div class="kdm-gear-grid">{{#each cells}}<div class="kdm-gear-cell"><label>Slot {{number}}<select name="system.gearGrid.{{key}}"><option value="">Empty</option>{{#if missing}}<option value="{{itemId}}" selected>Missing gear — clear this slot</option>{{/if}}{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{#if item}}<span class="kdm-gear-title">{{item.name}}</span><small>↑ {{item.system.affinities.top}} · → {{item.system.affinities.right}}<br>↓ {{item.system.affinities.bottom}} · ← {{item.system.affinities.left}}</small>{{else}}<span class="kdm-empty">Empty slot</span>{{/if}}</div>{{/each}}</div></section>
<section><h2>Inventory &amp; records</h2><p class="kdm-hint">Drop Items here from the Items directory or a compendium. Edit opens the owned copy. Save changes before adding or editing items.</p><div class="kdm-actions"><button type="button" data-action="addItem" data-type="gear">Add gear</button><button type="button" data-action="addItem" data-type="resource">Add resource</button></div><ul class="kdm-inventory">{{#each inventory}}<li data-item-id="{{id}}"><span>{{name}} <small>{{type}}{{#if (eq type "Resource")}} · {{quantity}}{{/if}}</small></span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></li>{{else}}<li>No items yet.</li>{{/each}}</ul></section><label class="kdm-notes">Game notes (visible to document viewers)<textarea name="system.notes" rows="4">{{system.notes}}</textarea></label></fieldset>{{#if editable}}<footer><button type="submit"><i class="fas fa-save"></i> Save changes</button></footer>{{else}}<p>Read-only. Ask the GM for ownership to edit.</p>{{/if}}</div>