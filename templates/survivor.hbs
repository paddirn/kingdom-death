<div class="kdm-body"><header class="kdm-survivor-header"><label>Survivor name<input name="name" value="{{actor.name}}" {{#unless editable}}disabled{{/unless}} required><small><em>When you name your survivor, gain <strong>+1 survival</strong>.</em></small></label><label>Sex<select name="system.sex" {{#unless editable}}disabled{{/unless}}>{{#each sexChoices}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{#if value}}{{value}}{{else}}Unspecified{{/if}}</option>{{/each}}</select></label></header>
<nav class="tabs kdm-tabs" data-group="primary" aria-label="Survivor tabs"><button type="button" data-action="tab" data-group="primary" data-tab="attributes" class="{{#if active.attributes}}active{{/if}}">Attributes</button><button type="button" data-action="tab" data-group="primary" data-tab="gear" class="{{#if active.gear}}active{{/if}}">Gear</button><button type="button" data-action="tab" data-group="primary" data-tab="specials" class="{{#if active.specials}}active{{/if}}">Specials</button></nav>
<fieldset {{#unless editable}}disabled{{/unless}}>
<div class="tab {{#if active.attributes}}active{{/if}}" data-group="primary" data-tab="attributes"><div class="kdm-paper-columns"><div>

<section class="kdm-survival"><h2>Survival</h2><div class="kdm-survival-layout"><div><div class="kdm-stats kdm-square-numbers"><label>Current Survival<input type="number" min="0" step="1" name="system.survival.value" value="{{system.survival.value}}"></label><label>Survival limit<input type="number" min="0" step="1" name="system.survival.limit" value="{{system.survival.limit}}"></label></div><label class="kdm-inline"><input type="checkbox" name="system.cannotSpendSurvival" {{checked system.cannotSpendSurvival}}>🔒 Cannot spend Survival</label></div><div class="kdm-action-checks">{{#each survivalActions}}<label class="kdm-inline"><input type="checkbox" name="system.survivalActions.{{key}}" {{checked checked}}>{{label}}</label>{{/each}}</div></div></section>
<div class="kdm-stat-boxes">{{#each attributes}}<label><input type="number" step="1" name="system.attributes.{{key}}" value="{{value}}"><span>{{label}}</span></label>{{/each}}</div>
<section class="kdm-square-numbers"><h2>Brain</h2><small><em>If your insanity is 3+, you are <strong>insane</strong>.</em></small><label>Insanity<input type="number" min="0" step="1" name="system.insanity" value="{{system.insanity}}"></label><label class="kdm-inline"><input type="checkbox" name="system.brainInjury" {{checked system.brainInjury}}>Brain Injury</label></section><section><h2>Injuries</h2><p class="kdm-injury-note"><span aria-hidden="true" class="kdm-filled-box"></span> Heavy Injury: Knocked Down (all locations)</p>{{#each locations}}<div class="kdm-location"><label class="kdm-armor">Armor<input type="number" min="0" step="1" name="system.locations.{{key}}.armor" value="{{armor}}"></label><h3><svg class="kdm-anatomy" aria-hidden="true" viewBox="0 0 24 24"><use href="systems/kingdom-death/styles/anatomy.svg#{{key}}"></use></svg>{{label}}</h3>{{#if hasLight}}<label>Light<input type="checkbox" name="system.locations.{{key}}.light" {{checked light}}></label>{{/if}}<label>Heavy<input type="checkbox" name="system.locations.{{key}}.heavy" {{checked heavy}}></label></div>{{/each}}</section></div><div>
<section><h2>Survivor</h2><div class="kdm-track"><h3>Hunt XP</h3>{{#with huntTrack}}<div class="kdm-track-boxes">{{#each boxes}}<input type="checkbox" aria-label="Hunt XP {{value}}" class="{{#if milestone}}milestone{{/if}}" data-action="progress" data-path="system.{{../path}}" data-value="{{value}}" {{checked checked}}>{{/each}}</div><label>XP:<input type="number" min="0" step="1" name="system.{{path}}" value="{{value}}"></label>{{/with}}</div><div class="kdm-checks"><label class="kdm-inline"><input type="checkbox" name="system.ageMilestones.age1" {{checked system.ageMilestones.age1}}>XP 2</label><label class="kdm-inline"><input type="checkbox" name="system.ageMilestones.age2" {{checked system.ageMilestones.age2}}>XP 6</label><label class="kdm-inline"><input type="checkbox" name="system.ageMilestones.age3" {{checked system.ageMilestones.age3}}>XP 10</label><label class="kdm-inline"><input type="checkbox" name="system.ageMilestones.age4" {{checked system.ageMilestones.age4}}>XP 15</label><label class="kdm-inline"><input type="checkbox" name="system.retired" {{checked system.retired}}>Retired</label></div><small>Age milestones: 2 / 6 / 10 / 15. Retirement marker: 16. Resolve milestones manually.</small></section>
<section><h2>Weapon Proficiency</h2><label>Type<input name="system.weaponProficiency.type" value="{{system.weaponProficiency.type}}"><small><em>Select Before Hunt</em></small></label><div class="kdm-track"><h3>Weapon Proficiency</h3>{{#with proficiencyTrack}}<div class="kdm-track-boxes">{{#each boxes}}<input type="checkbox" aria-label="Weapon Proficiency {{value}}" class="{{#if milestone}}milestone{{/if}}" data-action="progress" data-path="system.{{../path}}" data-value="{{value}}" {{checked checked}}>{{/each}}</div><label>Total<input type="number" min="0" step="1" name="system.{{path}}" value="{{value}}"></label>{{/with}}</div><label class="kdm-inline"><input type="checkbox" name="system.weaponProficiency.specialist" {{checked system.weaponProficiency.specialist}}>Specialist</label><label class="kdm-inline"><input type="checkbox" name="system.weaponProficiency.master" {{checked system.weaponProficiency.master}}>Master</label></section><section><div class="kdm-track"><h3>Courage</h3>{{#with courageTrack}}<div class="kdm-track-boxes">{{#each boxes}}<input type="checkbox" aria-label="Courage {{value}}" class="{{#if milestone}}milestone{{/if}}" data-action="progress" data-path="system.{{../path}}" data-value="{{value}}" {{checked checked}}>{{/each}}</div><label>Total<input type="number" min="0" step="1" name="system.{{path}}" value="{{value}}"></label>{{/with}}</div><small>Milestones: 3 · Bold / 9 · See the Truth</small>{{#with courageOptions}}<div class="kdm-radio-group" role="radiogroup" aria-label="{{path}}">{{#each options}}<label class="kdm-radio-option"><input type="radio" name="system.{{../path}}" value="{{value}}" {{checked selected}}><span><strong>{{title}}</strong>{{#if description}}: <small>{{description}}</small>{{/if}}</span></label>{{/each}}</div>{{/with}}</section><section><div class="kdm-track"><h3>Understanding</h3>{{#with understandingTrack}}<div class="kdm-track-boxes">{{#each boxes}}<input type="checkbox" aria-label="Understanding {{value}}" class="{{#if milestone}}milestone{{/if}}" data-action="progress" data-path="system.{{../path}}" data-value="{{value}}" {{checked checked}}>{{/each}}</div><label>Total<input type="number" min="0" step="1" name="system.{{path}}" value="{{value}}"></label>{{/with}}</div><small>Milestones: 3 · Insight / 9 · White Secret</small>{{#with understandingOptions}}<div class="kdm-radio-group" role="radiogroup" aria-label="{{path}}">{{#each options}}<label class="kdm-radio-option"><input type="radio" name="system.{{../path}}" value="{{value}}" {{checked selected}}><span><strong>{{title}}</strong>{{#if description}}: <small>{{description}}</small>{{/if}}</span></label>{{/each}}</div>{{/with}}</section><section><h2>Condition &amp; notes</h2><label>Bleeding tokens<input type="number" min="0" step="1" name="system.bleeding" value="{{system.bleeding}}"></label><label class="kdm-inline"><input type="checkbox" name="system.knockedDown" {{checked system.knockedDown}}>Knocked down</label><label class="kdm-inline"><input type="checkbox" name="system.dead" {{checked system.dead}}>Dead</label><label>Notes<textarea name="system.notes" rows="6">{{system.notes}}</textarea></label><small>Milestones, injuries and action restrictions are manual records.</small></section></div></div></div>
<div class="tab {{#if active.gear}}active{{/if}}" data-group="primary" data-tab="gear"><section><h2>Gear grid</h2><p class="kdm-hint">Add or drop gear into inventory, then assign it below and Save. Each owned copy can occupy one cell. Affinities are stored on gear; bonuses are not calculated.</p><div class="kdm-gear-grid">{{#each cells}}<div class="kdm-gear-cell"><label>Slot {{number}}<select name="system.gearGrid.{{key}}"><option value="">Empty</option>{{#if missing}}<option value="{{itemId}}" selected>Missing gear — clear this slot</option>{{/if}}{{#each choices}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>{{#if item}}<span class="kdm-gear-title">{{item.name}}</span><small>↑ {{item.system.affinities.top}} · → {{item.system.affinities.right}}<br>↓ {{item.system.affinities.bottom}} · ← {{item.system.affinities.left}}</small>{{else}}<span class="kdm-empty">Empty slot</span>{{/if}}</div>{{/each}}</div></section>
<section><h2>Inventory &amp; records</h2><p class="kdm-hint">Drop Items here from the Items directory or a compendium. Edit opens the owned copy. Save changes before adding or editing items.</p><div class="kdm-actions"><button type="button" data-action="addItem" data-type="gear">Add gear</button><button type="button" data-action="addItem" data-type="resource">Add resource</button></div><ul class="kdm-inventory">{{#each inventory}}<li data-item-id="{{id}}"><span>{{name}} <small>{{type}}{{#if (eq type "Resource")}} · {{quantity}}{{/if}}</small></span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></li>{{else}}<li>No items yet.</li>{{/each}}</ul></section></div><div class="tab {{#if active.specials}}active{{/if}}" data-group="primary" data-tab="specials"><section><h2>Fighting Arts</h2><p>Maximum 3</p><label class="kdm-inline"><input type="checkbox" name="system.cannotUseFightingArts" {{checked system.cannotUseFightingArts}}>🔒 Cannot use Fighting Arts</label><button type="button" data-action="addItem" data-type="fightingArt">Add Fighting Arts</button><ul class="kdm-inventory">{{#each arts}}<li data-item-id="{{id}}"><span>{{name}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></li>{{else}}<li>None recorded.</li>{{/each}}</ul></section><section><h2>Disorders</h2><p>Maximum 3</p><button type="button" data-action="addItem" data-type="disorder">Add Disorders</button><ul class="kdm-inventory">{{#each disorders}}<li data-item-id="{{id}}"><span>{{name}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></li>{{else}}<li>None recorded.</li>{{/each}}</ul></section><section><h2>Abilities &amp; Impairments</h2><label class="kdm-inline"><input type="checkbox" name="system.skipNextHunt" {{checked system.skipNextHunt}}>🔒 Skip Next Hunt</label><label>Impairments<textarea name="system.impairments" rows="4">{{system.impairments}}</textarea></label><button type="button" data-action="addItem" data-type="ability">Add Abilities &amp; Impairments</button><ul class="kdm-inventory">{{#each abilities}}<li data-item-id="{{id}}"><span>{{name}}</span><button type="button" data-action="editItem" data-item-id="{{id}}">Edit</button><button type="button" data-action="deleteItem" data-item-id="{{id}}">Remove</button></li>{{else}}<li>None recorded.</li>{{/each}}</ul></section><section><h2>Once Per Lifetime</h2><label>Notes<textarea name="system.oncePerLifetime" rows="4">{{system.oncePerLifetime}}</textarea></label><label class="kdm-inline"><input type="checkbox" name="system.rerollUsed" {{checked system.rerollUsed}}>Reroll Used</label></section></div></fieldset>{{#if editable}}<footer><button type="submit">Save changes</button></footer>{{else}}<p>Read-only. Ask the GM for ownership to edit.</p>{{/if}}</div>