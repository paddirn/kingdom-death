{{#*inline "settlementCards"}}<div class="kdm-settlement-cards {{cardClass}}">{{#each items}}<article class="draggable" data-item-id="{{id}}" draggable="true"><button type="button" data-action="editItem" data-item-id="{{id}}"><img src="{{img}}" alt="{{name}}"><span>{{name}}{{#if quantity}} · {{quantity}}{{/if}}</span></button>{{#if @root.editable}}<button type="button" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remove {{name}}">Remove</button>{{/if}}</article>{{else}}<p>No Items yet.</p>{{/each}}</div>{{/inline}}
<div class="kdm-body"><header class="kdm-header"><label>Name<input name="name" value="{{actor.name}}" required {{#unless editable}}disabled{{/unless}}></label>{{#if editable}}<button type="submit">Save Changes</button>{{/if}}</header>
<nav class="tabs kdm-tabs" data-group="primary" aria-label="Settlement tabs">{{#each tabs}}<button type="button" data-action="tab" data-group="primary" data-tab="{{id}}" class="{{#if active}}active{{/if}}">{{#if settings}}<i class="fas fa-cog" aria-hidden="true"></i> {{/if}}{{label}}</button>{{/each}}</nav>
<div class="tab {{#if active.main}}active{{/if}}" data-group="primary" data-tab="main">
<section><h2>Settlement &amp; Campaign</h2><fieldset {{#unless editable}}disabled{{/unless}}><div class="kdm-settlement-counters kdm-square-numbers">{{#each counters}}<label>{{label}}<input type="number" name="system.{{key}}" value="{{value}}" min="0" step="1"></label>{{/each}}</div></fieldset><p class="kdm-hint">Population includes survivors without Actor records. Survival limit does not overwrite individual records.</p></section>
<section data-kdm-drop="innovation"><h2>Innovations</h2>{{#if editable}}<button type="button" data-action="addItem" data-type="innovation">Add Innovation</button>{{/if}}{{> settlementCards items=innovations}}</section>
<section data-kdm-drop="storage"><h2>Settlement Storage</h2>{{#if editable}}<div class="kdm-actions"><button type="button" data-action="addItem" data-type="gear">Add Gear</button><button type="button" data-action="addItem" data-type="armor">Add Armor</button><button type="button" data-action="addItem" data-type="resource">Add Resource</button></div>{{/if}}{{> settlementCards items=inventory}}</section>
<label>Game notes<textarea name="system.notes" rows="4" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea></label></div>
<div class="tab {{#if active.population}}active{{/if}}" data-group="primary" data-tab="population"><h2>Population</h2><p>Accessible World Survivors; this list does not change the recorded Population total.</p><ul>{{#each population}}<li><button type="button" data-action="openSurvivor" data-actor-id="{{id}}">{{name}}</button></li>{{else}}<li>No accessible Survivors.</li>{{/each}}</ul></div>
<div class="tab {{#if active.locations}}active{{/if}}" data-group="primary" data-tab="locations"><section data-kdm-drop="settlementLocation"><h2>Locations</h2>{{#if editable}}<button type="button" data-action="addItem" data-type="settlementLocation">Add Location</button>{{/if}}{{> settlementCards items=locations cardClass="kdm-location-cards"}}</section></div>
<div class="tab {{#if active.settings}}active{{/if}}" data-group="primary" data-tab="settings"><fieldset {{#unless editable}}disabled{{/unless}}><section class="kdm-placeholder"><h2>Hunt board · foundation</h2><p>{{#if isHunt}}Current phase. {{/if}}Track coordinates are manual placeholders. No events, track length, or automatic transitions are implemented.</p><div class="kdm-stats"><label>Survivor position<input type="number" name="system.campaign.hunt.survivorPosition" value="{{system.campaign.hunt.survivorPosition}}" step="1" min="0"></label><label>Quarry position<input type="number" name="system.campaign.hunt.quarryPosition" value="{{system.campaign.hunt.quarryPosition}}" step="1" min="0"></label>
</div></section><section class="kdm-placeholder"><h2>Showdown board · foundation</h2><p>{{#if isShowdown}}Current phase. {{/if}}Create a native square-grid Scene and place survivor/monster tokens. Combat assistance is planned; changing phase does not activate a Scene.</p><label>Showdown Scene ID (reference only)<input name="system.campaign.showdownSceneId" value="{{system.campaign.showdownSceneId}}"></label></section>
</fieldset></div></div>
