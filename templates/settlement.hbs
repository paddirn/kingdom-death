{{#*inline "settlementCards"}}<div class="kdm-settlement-cards {{cardClass}}">{{#each items}}<article class="draggable" data-item-id="{{id}}" draggable="true"><button type="button" data-action="editItem" data-item-id="{{id}}"><img src="{{img}}" alt="{{name}}"><span>{{name}}{{#if quantity}} · {{quantity}}{{/if}}</span></button>{{#if @root.editable}}<button type="button" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remove {{name}}">Remove</button>{{/if}}</article>{{else}}<p>No Items yet.</p>{{/each}}</div>{{/inline}}
{{#*inline "settlementList"}}
<ul class="kdm-settlement-list">{{#each items}}<li class="draggable" data-item-id="{{id}}" draggable="true"><button type="button" data-action="editItem" data-item-id="{{id}}">{{name}} <small>({{type}}){{#if (eq itemType "resource")}} · {{quantity}}{{/if}}</small></button>{{#if @root.editable}}<button type="button" data-action="deleteItem" data-item-id="{{id}}" aria-label="Remove {{name}}">×</button>{{/if}}</li>{{else}}<li>No Items yet.</li>{{/each}}</ul>
{{/inline}}
{{#*inline "populationList"}}<ul>{{#each items}}<li><button type="button" data-action="openSurvivor" data-actor-id="{{id}}">{{name}}</button></li>{{else}}<li>No accessible Survivors.</li>{{/each}}</ul>{{/inline}}
<div class="kdm-body">
<div class="tab {{#if active.main}}active{{/if}}" data-group="primary" data-tab="main"><ol class="kdm-settlement-flow" aria-label="Settlement phase reference">{{#each flow}}<li>{{this}}{{#unless @last}}<span aria-hidden="true">→</span>{{/unless}}</li>{{/each}}</ol></div>
<header class="kdm-record-header">
  <div class="kdm-avatar"><button type="button" data-action="portraitPreview" aria-label="View Settlement portrait"><img src="{{actor.img}}" alt="{{actor.name}}"></button>{{#if editable}}<button type="button" data-action="portraitChange" aria-label="Change Settlement portrait">Change</button>{{/if}}</div>
  <label class="kdm-name-field">Settlement name<input name="name" value="{{actor.name}}" required {{#unless editable}}disabled{{/unless}}></label>
  <small class="kdm-name-reminder"><em>When the settlement is named for the first time, <strong>returning survivors</strong> gain +1 survival.</em></small>
  {{#if editable}}<button class="kdm-header-save" type="submit">Save Changes</button>{{/if}}
</header>
<nav class="tabs kdm-tabs" data-group="primary" aria-label="Settlement tabs">{{#each tabs}}<button type="button" data-action="tab" data-group="primary" data-tab="{{id}}" class="{{#if active}}active{{/if}}">{{#if settings}}<i class="fas fa-cog" aria-hidden="true"></i> {{/if}}{{label}}</button>{{/each}}</nav>
<div class="tab {{#if active.main}}active{{/if}}" data-group="primary" data-tab="main">
<section><h2>Settlement &amp; Campaign</h2><fieldset {{#unless editable}}disabled{{/unless}}>
<div class="kdm-settlement-counters kdm-square-numbers">{{#each counters}}<label>{{label}}<input type="number" name="system.{{key}}" value="{{value}}" min="0" step="1"></label>{{/each}}</div>
<hr><label class="kdm-inline"><input type="checkbox" name="system.portcullisKey" {{checked system.portcullisKey}}>Portcullis Key</label>
<div class="kdm-lost-settlements"><span>Lost Settlements</span><div class="kdm-record-checks">{{#each lostSettlements}}<input type="checkbox" name="system.lostSettlements.{{key}}" aria-label="Lost Settlement {{number}}" title="Lost Settlement {{number}}" class="{{#if emphasized}}kdm-emphasized-check{{/if}}" {{checked checked}}>{{/each}}</div></div>
</fieldset></section>
<section><h2>Principles</h2><div class="kdm-principles">{{#each principles}}<div class="kdm-principle" data-kdm-drop="principle" data-principle="{{key}}" aria-label="{{#if label}}{{label}}{{else}}Additional Principle{{/if}}"><span>{{label}}</span>{{#if available}}<button type="button" data-action="editItem" data-item-id="{{id}}">{{name}}</button>{{else}}<span class="kdm-empty">{{name}}</span>{{/if}}{{#if @root.editable}}{{#if id}}<button type="button" data-action="clearPrinciple" data-principle="{{key}}" aria-label="Clear Principle assignment">×</button>{{/if}}{{/if}}</div>{{/each}}</div></section>
<section data-kdm-drop="innovation"><h2>Innovations</h2>{{#if editable}}<button type="button" data-action="addItem" data-type="innovation">Add Innovation</button>{{/if}}{{> settlementList items=innovations}}</section>
<section data-kdm-drop="storage"><h2>Settlement Storage</h2>{{#if editable}}<div class="kdm-actions"><button type="button" data-action="addItem" data-type="gear">Add Gear</button><button type="button" data-action="addItem" data-type="armor">Add Armor</button><button type="button" data-action="addItem" data-type="resource">Add Resource</button></div>{{/if}}{{> settlementList items=inventory}}</section>
<label>Game notes<textarea name="system.notes" rows="4" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea></label></div>
<div class="tab {{#if active.population}}active{{/if}}" data-group="primary" data-tab="population">
<section><h2>Death Count</h2><div class="kdm-death-scroll"><div class="kdm-death-count">{{#each deathBoxes}}<input type="checkbox" disabled aria-label="Death {{number}}" class="{{#if emphasized}}kdm-emphasized-check{{/if}}" {{checked checked}}>{{/each}}</div></div><p>Dead Survivors: <strong>{{deathCount}}</strong></p></section>
<section><h2>Living Survivors</h2>{{> populationList items=living}}</section><section><h2>Dead Survivors</h2>{{> populationList items=dead}}</section></div>
<div class="tab {{#if active.timeline}}active{{/if}}" data-group="primary" data-tab="timeline"><fieldset {{#unless editable}}disabled{{/unless}}>
<section><h2>Milestones</h2><div class="kdm-milestones">{{#each milestones}}<div><input type="checkbox" name="system.milestones.{{key}}.checked" aria-label="Milestone {{key}}" {{checked checked}}>{{#if custom}}<input name="system.milestones.{{key}}.label" value="{{label}}" aria-label="Custom milestone {{key}} name">{{else}}<span>{{label}}</span>{{/if}}</div>{{/each}}</div></section>
<div class="kdm-timeline-scroll" tabindex="0" aria-label="Timeline table, scroll horizontally"><table class="kdm-timeline"><thead><tr><th>Lantern Year</th><th>Settlement Events</th><th>Story Events</th><th>Developments</th><th>Births</th><th>Deaths</th><th>Monster</th></tr></thead><tbody>
{{#each timeline}}<tr>
<th scope="row"><button type="button" data-action="recordToggle" data-path="system.timeline.{{key}}.active" class="kdm-record-toggle {{#if active}}active{{/if}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" aria-label="Lantern Year {{year}}">{{year}}</button></th>
<td><input name="system.timeline.{{key}}.settlementEvents" value="{{settlementEvents}}" aria-label="Year {{year}} Settlement Events"></td>
<td><div class="kdm-story-event"><button type="button" data-action="recordToggle" data-path="system.timeline.{{key}}.storyState" class="kdm-story-toggle" aria-label="Year {{year}} Story Events: {{storyLabel}}" title="{{storyLabel}}; click to cycle">{{#if hasSwords}}<i class="fas fa-swords" aria-hidden="true"></i>{{/if}}{{#if hasBook}}<i class="fas fa-book" aria-hidden="true"></i>{{/if}}</button><input name="system.timeline.{{key}}.storyEvents" value="{{storyEvents}}" aria-label="Year {{year}} Story Events text"></div></td>
<td><input name="system.timeline.{{key}}.developments" value="{{developments}}" aria-label="Year {{year}} Developments"></td>
<td><input name="system.timeline.{{key}}.births" value="{{births}}" aria-label="Year {{year}} Births"></td>
<td><input name="system.timeline.{{key}}.deaths" value="{{deaths}}" aria-label="Year {{year}} Deaths"></td>
<td><input name="system.timeline.{{key}}.monster" value="{{monster}}" aria-label="Year {{year}} Monster"></td>
</tr>{{/each}}</tbody></table></div></fieldset></div>
<div class="tab {{#if active.locations}}active{{/if}}" data-group="primary" data-tab="locations"><section data-kdm-drop="settlementLocation"><h2>Locations</h2>{{#if editable}}<button type="button" data-action="addItem" data-type="settlementLocation">Add Location</button>{{/if}}{{> settlementCards items=locations cardClass="kdm-location-cards"}}</section></div>
<div class="tab {{#if active.monsters}}active{{/if}}" data-group="primary" data-tab="monsters"><fieldset {{#unless editable}}disabled{{/unless}}><div class="kdm-monster-records">{{#each monsterGroups}}<section><h2>{{title}}</h2><div class="kdm-monster-record-heading"><span>Monster</span><span>Level</span></div>{{#each rows}}<div class="kdm-monster-record"><input type="checkbox" name="system.monsterTracking.{{group}}.{{key}}.enabled" aria-label="{{../title}} {{key}} enabled" {{checked enabled}}>{{#if custom}}<input name="system.monsterTracking.{{group}}.{{key}}.name" value="{{name}}" aria-label="Custom {{../title}} {{key}} name">{{else}}<span>{{name}}</span>{{/if}}<div class="kdm-levels">{{#each levels}}<button type="button" data-action="recordToggle" data-path="{{path}}" class="kdm-record-toggle {{#if active}}active{{/if}}" aria-pressed="{{#if active}}true{{else}}false{{/if}}" aria-label="{{../../title}} {{../key}} level {{number}}">{{number}}</button>{{/each}}</div></div>{{/each}}</section>{{/each}}</div></fieldset></div>
<div class="tab {{#if active.settings}}active{{/if}}" data-group="primary" data-tab="settings"><fieldset {{#unless editable}}disabled{{/unless}}><section class="kdm-placeholder"><h2>Hunt board · foundation</h2><p>{{#if isHunt}}Current phase. {{/if}}Track coordinates are manual placeholders. No events, track length, or automatic transitions are implemented.</p><div class="kdm-stats"><label>Survivor position<input type="number" name="system.campaign.hunt.survivorPosition" value="{{system.campaign.hunt.survivorPosition}}" step="1" min="0"></label><label>Quarry position<input type="number" name="system.campaign.hunt.quarryPosition" value="{{system.campaign.hunt.quarryPosition}}" step="1" min="0"></label>
</div></section><section class="kdm-placeholder"><h2>Showdown board · foundation</h2><p>{{#if isShowdown}}Current phase. {{/if}}Create a native square-grid Scene and place survivor/monster tokens. Combat assistance is planned; changing phase does not activate a Scene.</p><label>Showdown Scene ID (reference only)<input name="system.campaign.showdownSceneId" value="{{system.campaign.showdownSceneId}}"></label></section>
</fieldset></div></div>
